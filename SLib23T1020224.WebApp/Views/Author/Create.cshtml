@model SLib23T1020224.Models.Entities.Author

@{
    ViewData["Title"] = "Thêm tác giả";
}

<h1>Thêm tác giả</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="AuthorName" class="form-label">Tên tác giả</label>
                <input asp-for="AuthorName" class="form-control" maxlength="200" />
            </div>

            <div class="mb-3">
                <label asp-for="Biography" class="form-label">Tiểu sử</label>
                <textarea asp-for="Biography" class="form-control" rows="4"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BirthDate" class="form-label">Ngày sinh</label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DeathDate" class="form-label">Ngày mất</label>
                    <input asp-for="DeathDate" type="date" class="form-control" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>