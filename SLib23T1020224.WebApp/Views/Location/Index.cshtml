@model IEnumerable<SLib23T1020224.Models.Entities.Location>

@{
    ViewBag.Title = "Danh sách vị trí lưu trữ";
}

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm vị trí lưu trữ</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có vị trí lưu trữ nào.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Mã vị trí</th>
                <th>Tên vị trí</th>
                <th>Tầng</th>
                <th>Phòng</th>
                <th>Kệ</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.LocationId</td>
                    <td>@item.LocationCode</td>
                    <td>@item.LocationName</td>
                    <td>@item.Floor</td>
                    <td>@item.Room</td>
                    <td>@item.Shelf</td>
                    <td>@(item.IsActive ? "Đang sử dụng" : "Ngừng sử dụng")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.LocationId" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.LocationId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.LocationId" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}