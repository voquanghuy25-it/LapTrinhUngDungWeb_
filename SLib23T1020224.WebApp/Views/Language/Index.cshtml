@model IEnumerable<SLib23T1020224.Models.Entities.Language>

@{
    ViewBag.Title = "Danh mục ngôn ngữ";
}

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm ngôn ngữ</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có ngôn ngữ nào.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Mã ngôn ngữ</th>
                <th>Tên ngôn ngữ</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.LanguageId</td>
                    <td>@item.LanguageCode</td>
                    <td>@item.LanguageName</td>
                    <td>@(item.IsActive ? "Đang sử dụng" : "Ngừng sử dụng")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.LanguageId" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.LanguageId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.LanguageId" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}