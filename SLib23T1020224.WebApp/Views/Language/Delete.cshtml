@model SLib23T1020224.Models.Entities.Language

@{
    ViewData["Title"] = "Xóa ngôn ngữ";
    var inUsed = (bool?)ViewBag.InUsed ?? false;
}

<h1>Xóa ngôn ngữ</h1>

<div asp-validation-summary="All" class="text-danger"></div>

@if (inUsed)
{
    <div class="alert alert-warning">
        Ngôn ngữ này đã có sách nên không thể xóa.
    </div>
}
else
{
    <p class="lead">Bạn có chắc chắn muốn xóa ngôn ngữ này không?</p>
}

<dl class="row">
    <dt class="col-sm-3">Mã</dt>
    <dd class="col-sm-9">@Model.LanguageId</dd>

    <dt class="col-sm-3">Mã ngôn ngữ (ví dụ: vi, en)</dt>
    <dd class="col-sm-9">@Model.LanguageCode</dd>

    <dt class="col-sm-3">Tên ngôn ngữ</dt>
    <dd class="col-sm-9">@Model.LanguageName</dd>

    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Đang sử dụng" : "Ngừng sử dụng")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.LanguageId" method="post">
    @if (!inUsed)
    {
        <button type="submit" class="btn btn-danger">Xóa</button>
    }
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>